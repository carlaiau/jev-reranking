# These mode switches configure the preserved legacy pipeline entry points.
# New stage1/run.py is lexical-only; run reranking/run.py separately.
OPENAI_API_KEY=

# Legacy reranker, disabled when JEV is enabled.
JASSJR_OPENAI_RERANK_MODE=off

# Optional tri-source dense retrieval scaffold for issue #38.
# Supported values: off, openai
JASSJR_SEMANTIC_MODE=openai
JASSJR_SEMANTIC_MODEL=text-embedding-3-small
JASSJR_SEMANTIC_DIMENSIONS=512
JASSJR_SEMANTIC_DOC_WORDS=220
JASSJR_SEMANTIC_BATCH_SIZE=64
JASSJR_SEMANTIC_TOPK=1000

# Weighted reciprocal rank fusion settings for the tri-source scaffold.
JASSJR_FUSION_RRF_K=60
JASSJR_FUSION_WEIGHT_BM25=0.05
JASSJR_FUSION_WEIGHT_RM3=0.55
JASSJR_FUSION_WEIGHT_DENSE=0.40
JASSJR_FUSION_BM25_TOPK=250
JASSJR_FUSION_RM3_TOPK=250
JASSJR_FUSION_DENSE_TOPK=250

# Retain the later recall-side expansion and sparse query rewrite sources.
JASSJR_OPENAI_QUERY_REWRITE_MODE=sparse
JASSJR_FUSION_WEIGHT_RM3_EXPANSION=0.10
JASSJR_FUSION_WEIGHT_QUERY_REWRITE=0.08
JASSJR_FUSION_WEIGHT_QUERY_REWRITE_RM3EXP=0.05

# JEV is the sole final reranker when enabled: off or pointwise.
TYPESAFE_API_KEY=
JASSJR_JEV_RERANK=pointwise
JASSJR_JEV_PYTHON=python3
JASSJR_JEV_MODEL=jev-latest
JASSJR_JEV_TOP_K=100

# Simulator database. Keep real connection strings in the ignored .env.
DATABASE_URL=
DATABASE_URL_POOLED=
